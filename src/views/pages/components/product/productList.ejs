                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div
    class="modal fade"
    id="editModal"
    tabindex="-1"
    aria-labelledby="editModal"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editModal">Chỉnh sửa</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col">
              <div class="d-flex flex-column bd-highlight mb-3">
                <div class="p-2" style="text-align: center;"> <img src="" height="200px" width="200px" id="imageUploadEdit" /></div>
                <div class="p-2" style="text-align: center;"><input type="file" name="file" id="image_file_edit" />
                  <button type="button" class="btn btn-outline-primary" onclick="uploadImageForEdit()">
                    Lưu ảnh
                  </button>
                </div>
              </div>
            </div>
            <div class="col">
              <form class="row g-3" action="/admin/book/edit" method="post">
                <div class="col-md-12">
                  <input
                    style="display: none"
                    type="text"
                    class="form-control"
                    name="imageUrl"
                    id="imageUrlEdit"
                    value=""
                  />
                </div>
                <div>
                  <input
                    type="hidden"
                    class="form-control"
                    id="_idEdit"
                    name="id"
                    value=""
                  />
                </div>
                <div class="col-md-6">
                  <label for="name" class="form-label">Tiêu đề</label>
                  <input
                    type="text"
                    class="form-control"
                    id="nameEdit"
                    name="title"
                    placeholder="Nhập tên"
                    value=""
                    required
                  />
                </div>
                <div class="col-6">
                  <label for="price" class="form-label">Giá</label>
                  <input
                    type="number"
                    class="form-control"
                    id="priceEdit"
                    name="price"
                    placeholder="Nhập giá"
                    value=""
                    min="0"
                    required
                  />
                </div>
                <div class="col-6">
                  <label for="categoriEdit" class="form-label">Danh mục</label>
                  <select
                    name="category"
                    id="categoriEdit"
                    class="form-select"
                    aria-label="Select category"
                    required
                  >
                    <option>---</option>
                    <% listCategories.forEach((item) => { %>
                    <option value="<%= item.id %>"><%= item.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-6">
                  <label for="authorEdit" class="form-label">Shop</label>
                  <select
                    name="author"
                    id="authorEdit"
                    class="form-select"
                    aria-label="Select author"
                    required
                  >
                    <option>---</option>
                    <% listAuthor.forEach((item) => { %>
                    <option value="<%= item.id %>"><%= item.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-12">
                  <label for="price" class="form-label">Gía giảm tối thiểu</label>
                  <input
                    type="number"
                    class="form-control"
                    id="limitDiscountEdit"
                    name="limitDiscount"
                    placeholder="Nhập giá"
                    min="0"
                    required
                    value=""
                  />
                </div>
                <div class="col-12">
                  <label for="descriptionEdit" class="form-label">Mô tả</label>
                  <textarea
                    class="form-control"
                    id="descriptionEdit"
                    name="description"
                    placeholder="Nhập mô tả"
                    rows="3"
                    value=""
                    required
                  ></textarea>
                </div>
    
                <div class="col-12">
                  <div class="modal-footer">
                    <button
                      type="button"
                      class="btn btn-secondary"
                      data-bs-dismiss="modal"
                    >
                      Đóng
                    </button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                  </div>
                </div>
              </form>
              <script>
                function uploadImage() {
                  const fileInput = document.getElementById('image_file');
                  const formData = new FormData();
                  formData.append('file', fileInput.files[0]);
              
                  fetch('/admin/book/image', {
                    method: 'POST',
                    body: formData,
                  })
                    .then((response) => response.json())
                    .then((data) => {
                      console.log('Uploaded Image URL:', data.secure_url);
                      document.getElementById('imageUrl').value = data.secure_url; // Set the URL in the hidden input
                    })
                    .catch((error) => console.error('Error uploading image:', error));
                }
              
                function checkImageUrlBeforeSubmit() {
                  const imageUrl = document.getElementById('imageUrl').value;
                  console.log('Image URL before form submit:', imageUrl);
                }
              </script>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</div>
