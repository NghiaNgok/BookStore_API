                      name="category"
                      id="category"
                      class="form-select"
                      required
                    >
                      <option value="" disabled selected>Chọn danh mục</option>
                      <% listCategories.forEach((item) => { %>
                      <option value="<%= item.id %>"><%= item.name %></option>
                      <% }) %>
                    </select>
                  </div>
                
                  <!-- Author dropdown -->
                  <div class="col-md-6">
                    <input type="hidden" name="author" value="16d18055-0420-4523-b7f5-7ae4c4958311" />
                  </div>
                
                  <!-- Limit discount input -->
                  <div class="col-12">
                    <label for="limitDiscount" class="form-label">Giảm giá tối đa</label>
                    <input
