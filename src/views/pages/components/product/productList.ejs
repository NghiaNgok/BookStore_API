<script>
  // Utility function to format price in VNĐ with dots as thousand separators
  function formatToVND(amount) {
    if (isNaN(amount)) return "";
    return amount.toLocaleString("vi-VN", { style: "decimal" }) + " VNĐ";
  }

  // Function to dynamically format prices in the "Giá" column
  function formatPricesInTable() {
    const priceCells = document.querySelectorAll(".price-cell");
    priceCells.forEach((cell) => {
      const rawPrice = parseInt(cell.dataset.rawPrice, 10);
      if (!isNaN(rawPrice)) {
        cell.textContent = formatToVND(rawPrice); // Format and update the text content
      }
    });
  }

  // Call this function on page load to format initial prices
  document.addEventListener("DOMContentLoaded", () => {
    formatPricesInTable();
  });
</script>

<div class="jumbotron p-3">
  <div class="card p-3 mb-3">
    <div class="d-flex bd-highlight">
      <div class="me-auto p-2 bd-highlight"><h3>QUẢN LÝ SẢN PHẨM</h3></div>
      <div class="p-2 bd-highlight">
        <button
          type="button"
          class="btn btn-primary"
          data-bs-toggle="modal"
          data-bs-target="#createModal"
        >
          Thêm mới
        </button>
      </div>
    </div>
  </div>

  <div class="card p-3 mb-3">
    <form action="/admin/book" method="get">
      <div class="d-flex justify-content-around align-items-center">
        <div class="p-2">
          <input
            id="title"
            name="title"
            type="text"
            class="form-control"
            placeholder="Tên sản phẩm"
            value="<%= filters.title %>"
          />
        </div>
        <div style="width: 250px;" class="p-2">
          <select id="category" name="category" class="form-select">
            <option hidden value="">-Danh mục-</option>
            <% for (var i = 0; i < listCategories.length; i++) {
              var selected =
                listCategories[i].id === filters.category[0] ? "selected" : ""; %>
            <option value="<%= listCategories[i].id %>" <%= selected %>>
              <%= listCategories[i].name %>
            </option>
            <% } %>
          </select>
        </div>
        <div style="width: 250px;" class="p-2">
          <select
            name="rate"
            id="rate"
            class="form-select"
            aria-label="Select rate"
          >
            <option hidden value="">-Đánh giá-</option>
            <option value=0 <%= filters.rate[0] === 0 ? "selected" : "" %> >
              0 sao
            </option>
            <option value=1 <%= filters.rate[0] === 1 ? "selected" : "" %> >
              1 sao
            </option>
            <option value=2 <%= filters.rate[0] === 2 ? "selected" : "" %> >
              2 sao
            </option>
            <option value=3 <%= filters.rate[0] === 3 ? "selected" : "" %> >
              3 sao
            </option>
            <option value=4 <%= filters.rate[0] === 4 ? "selected" : "" %> >
              4 sao
            </option>
            <option value=5 <%= filters.rate[0] === 5 ? "selected" : "" %> >
              5 sao
            </option>
          </select>
        </div>
        <div class="p-2">
          <button class="btn btn-primary" type="submit">Tìm kiếm</button>
          <button
            type="button"
            class="btn btn-outline-secondary"
            onclick="onClickResetProduct()"
          >
            Reset
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Pagination Section (Bottom) -->
  <% if(data.length > 0) { %>
    <table class="table table-bordered bg-white mt-3">
      <thead>
        <tr>
          <th scope="col">Hình ảnh</th>
          <th scope="col">Tên sản phẩm</th>
          <th scope="col">Danh mục</th>
          <th scope="col">Tác giả</th>
          <th scope="col">Đánh giá</th>
          <th scope="col">Giá</th>
          <th scope="col">Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(function(item, index) { %>
        <tr>
          <td class="w-2">
            <div class="text-center">
              <img src="<%= item.imageUrl %>" height="50px" width="50px" />
            </div>
          </td>
          <td
            style="cursor: pointer"
            class="w-10"
            data-bs-toggle="tooltip"
            data-bs-placement="right"
            title="<%= item.title %>"
          >
            <span class="d-inline-block text-truncate" style="max-width: 200px">
              <%= item.title %>
            </span>
          </td>
          <td class="w-2"><%= item.category.name %></td>
          <td scope="w-2"><%= item.author.name %></td>
          <td class="w-2">
            <% for (var j = 0; j < 5; j++) { %> 
              <% if (j < Math.floor(item.rate)) { %> 
                <i class="bi bi-star-fill" style="color: gold;"></i>  <!-- Sao đầy đủ -->
              <% } else if (j < item.rate) { %> 
                <i class="bi bi-star-half" style="color: gold;"></i> <!-- Sao một nửa -->
              <% } else { %> 
                <span class="fa fa-star"></span>  <!-- Sao rỗng -->
              <% } %> 
            <% } %>
          </td>
          <td class="w-2 price-cell" data-raw-price="<%= item.price %>"></td>
          <td class="w-2">
            <% if (item.isActive) { %>
              <span class="badge bg-success">Đang hoạt động</span>
            <% } else { %>
              <span class="badge bg-danger">Đã khóa</span>
            <% } %>
          </td>
          <td class="w-2">
            <button
              data-bs-toggle="modal"
              data-bs-target="#editModal"
              type="button"
              class="btn btn-outline-primary"
              onclick='editProduct("<%= item.id %>")'
            >
            <i class="bi bi-pencil-square"></i>
            </button>
            <button
              onclick='deleteBook("<%= item.id %>")'
              type="button"
              class="btn btn-outline-danger"
            >
            <i class="bi bi-shield-lock"></i>
            </button>
            <button
              onclick='activeBook("<%= item.id %>")'
              type="button"
              class="btn btn-outline-success"
            >
            <i class="bi bi-check-lg"></i>
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <!-- Pagination Controls -->
    <nav aria-label="Page navigation example">
      <ul class="pagination">
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage - 1 %>" aria-label="Previous">
            <span aria-hidden="true">&laquo;</span>
          </a>
        </li>
        <% for (var i = 1; i <= pages; i++) { %>
          <% var isActived = i === currentPage ? "active" : ""; %>
          <li class="page-item <%= isActived %>">
            <form action="/admin/book" method="get">
              <input type="hidden" name="page" value="<%= i %>" />
              <input name="title" type="hidden" value="<%= filters.title %>" />
              <input name="category" type="hidden" value="<%= filters.category %>" />
              <input name="rate" type="hidden" value="<%= filters.rate %>" />
              <button type="submit" class="btn btn-link page-link">
                <%= i %>
              </button>
            </form>
          </li>
        <% } %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= currentPage + 1 %>" aria-label="Next">
            <span aria-hidden="true">&raquo;</span>
          </a>
        </li>
      </ul>
    </nav>
  <% } else { %>
    <div class="col-12">
      <div class="card bg-light p-5">
        <img
          style="margin: auto"
          width="200px"
          height="200px"
          src="https://www.foxrentacar.com/media/1261/no-record-found.png"
          alt="Not Found"
        />
        <h4 class="text-center">Không tìm thấy sản phẩm nào</h4>
      </div>
    </div>
  <% } %>
</div>

  
