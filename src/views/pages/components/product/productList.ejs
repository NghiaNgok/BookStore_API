            aria-label="Close"
          ></button>
        </div>
        <div class="modal-body">
          <div class="container">
            <div class="row">
              <div class="col">
                <div class="d-flex flex-column bd-highlight mb-3">
                  <div class="p-2" style="text-align: center;"> <img src="" height="200px" width="200px" id="imageUpload" /></div>
                  <div class="p-2" style="text-align: center;"><input type="file" name="file" id="image_file" />
                    <button type="button" class="btn btn-outline-primary" onclick="uploadImage()">
                      Lưu ảnh
                    </button>
                  </div>
                </div>
               
                
              </div>
              <div class="col">
                <form class="row g-3" action="/admin/book/create" method="post">
                  <!-- Hidden field for image URL -->
                  <input type="hidden" name="imageUrl" id="imageUrl" value="" />
                
                  <!-- Title input -->
                  <div class="col-md-6">
                    <label for="title" class="form-label">Tiêu đề sản phẩm</label>
                    <input
                      type="text"
                      class="form-control"
                      id="title"
                      name="title"
                      placeholder="Nhập tên"
                      required
                    />
                  </div>
                
                  <!-- Price input -->
                  <div class="col-md-6">
                    <label for="price" class="form-label">Giá</label>
                    <input
                      type="number"
                      class="form-control"
                      id="price"
                      name="price"
                      placeholder="Nhập giá"
